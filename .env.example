# ─────────────────────────────────────────────────────────────────────────────
# B👀KED Lite settings.
# Copy this file to `.env` for local use. On Vercel, add these in
#   Project → Settings → Environment Variables   (never commit real values!)
# SETUP.md explains where to get each one.
# ─────────────────────────────────────────────────────────────────────────────

# Who can sign in to the admin area (your email). Comma-separate several.
ALLOWED_EMAILS=you@example.com

# A long random string. Generate one: https://generate-secret.vercel.app/32
AUTH_SECRET=

# Database (Turso). Leave empty locally to use a file in .data/
# (TURSO_DATABASE_URL / TURSO_AUTH_TOKEN from the Vercel ↔ Turso integration also work.)
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Email (Resend). Leave empty locally: emails are printed in the terminal instead.
RESEND_API_KEY=
# Must use a domain you verified in Resend, e.g. "Example Stays <bookings@example.com>"
EMAIL_FROM=

# Google Calendar (Google Cloud → OAuth client, type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: Zoom (marketplace.zoom.us → General App, user-managed). See SETUP.md → "Optional: Zoom".
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Protects the reminder email job. Another long random string.
CRON_SECRET=

# Optional: your site's address if you use a custom domain, e.g. https://book.example.com
# (On Vercel this is detected automatically.)
APP_URL=

# Optional: timezone for brand-new accounts (you can change it in Admin → Availability)
DEFAULT_TIMEZONE=America/New_York

# Optional: send reminders this many hours before a booking (default 24)
REMINDER_HOURS=24

# Testing only: CALENDAR_PROVIDER=fake uses a pretend calendar in .data/fake-calendar.json
CALENDAR_PROVIDER=
